{
  "name": "reaper-mcp-mac",
  "version": "0.1.0",
  "description": "MCP server for controlling a live REAPER DAW session on macOS via a Lua ReaScript bridge",
  "type": "module",
  "bin": {
    "reaper-mcp-mac": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx src/index.ts",
    "smoke": "node --import tsx src/smoke.ts",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
